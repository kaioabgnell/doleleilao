APP_NAME="Dole Leilao"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doleleilao
DB_USERNAME=doleleilao
DB_PASSWORD=doleleilao

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Redis local é compartilhado com outros projetos: banco e prefixo próprios.
REDIS_DB=4
REDIS_CACHE_DB=5
REDIS_PREFIX=doleleilao_

# E-mails pelo Sequenzy (SMTP). Cole a chave em SEQUENZY_API_KEY (Settings > API Keys & SMTP,
# permissão transactional:send; começa com seq_live_). Enquanto estiver vazia, os e-mails vão para o log.
# O MAIL_FROM_ADDRESS precisa ser de um domínio verificado no Sequenzy (Settings > Domain).
# Depois de mudar estas linhas, reinicie o `npm run dev`: a fila (Horizon) só lê o .env ao iniciar.
MAIL_MAILER=sequenzy
SEQUENZY_API_KEY=
SEQUENZY_SMTP_PORT=587
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@doleleilao.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


REVERB_APP_ID=doleleilao-local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8085

# Cache das lojas no site (o mesmo valor em apps/web/.env.local)
REVALIDATE_SECRET=
